# Copy this file to .env and fill in real values before deploying.
# Locally, leaving .env absent (or these unset) keeps the current dev
# defaults: DEBUG=True and the insecure fallback key in settings.py.

# Generate a real one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me-to-a-real-random-secret-key

DJANGO_DEBUG=False

# Comma-separated list of domains/IPs this is served from, e.g.:
# DJANGO_ALLOWED_HOSTS=stampone.example.com,193.136.230.30
DJANGO_ALLOWED_HOSTS=*
